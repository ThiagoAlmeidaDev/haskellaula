{
    "name": "Haskell aula",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": { "label": "Recall" },
        "5432": { "label": "PostgreSQL", "onAutoForward": "ignore" }
    },
    "containerEnv": {
        "TZ": "America/Sao_Paulo"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    "postCreateCommand": "cabal update && cabal build all",
    "postStartCommand": "bash .devcontainer/iniciar-servidor.sh",
    "customizations": {
        "vscode": {
            "extensions": ["haskell.haskell"]
        }
    }
}
